# ============================================================
# Paper.io 2 - Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Server port (default: 3000)
PORT=3000

# Session secret - change this to a long random string!
SESSION_SECRET=change_this_to_a_random_secret_string

# ── Discord OAuth ─────────────────────────────────────────────
# 1. Go to https://discord.com/developers/applications
# 2. Create a New Application
# 3. Go to OAuth2 -> General
# 4. Copy Client ID and Client Secret below
# 5. Add redirect URL: http://localhost:3000/auth/discord/callback
#    (for production use your real domain)

DISCORD_CLIENT_ID=1546500518032183397
DISCORD_CLIENT_SECRET=G6CQavHnwdrN23rFNq9voiYjL6dZvdte
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
